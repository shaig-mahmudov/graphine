{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphine.local/schema/question.schema.json",
  "title": "Graphine benchmark question",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "fixture", "category", "question", "difficulty", "expected_capabilities", "token_budget"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 3 },
    "fixture": { "enum": ["java-core", "spring-web", "spring-beans", "spring-data"] },
    "category": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "question": { "type": "string", "minLength": 10 },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "expected_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "token_budget": { "type": "integer", "minimum": 1 },
    "support": { "enum": ["phase-0", "planned"] }
  }
}

